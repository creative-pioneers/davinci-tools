// false_color_bfilm5.dctl
// ---------------------------------------------------------------------------
// Purpose:   False color exposure map tuned for Blackmagic Film Gen5 log values
// Input:     Blackmagic Film Gen5 encoded
// Output:    False color overlay with zone-based coloring
// Reference: Zone thresholds derived from forward encoding of semantic linear values
//            through Blackmagic Film Gen5 transfer characteristic
// Verified:  DaVinci Resolve 18.6
// Note:      Zone thresholds tuned to Blackmagic Film Gen5 IRE values.
//            Middle grey (~18% linear) encodes to approximately 0.298 in BMFilm Gen5
//            (notably lower than other formats — reflects the log2-based encoding's
//            lower midtone placement compared to log10-based formats like S-Log3).
//            For a format-agnostic version with adjustable thresholds see false_color.dctl.
//            For other formats see false_color_clog3.dctl, false_color_slog3.dctl, etc.
// ---------------------------------------------------------------------------
//
// Zone scheme (BMFilm Gen5 IRE values, derived from forward encoding of reference linears):
//   Purple  : < 0.038   - crushed / underexposed blacks      (linear ~0.005)
//   Blue    : 0.038-0.092 - deep shadows                     (linear ~0.018)
//   Teal    : 0.092-0.225 - shadow detail                    (linear ~0.09)
//   Green   : 0.225-0.305 - middle grey (~18% grey = ~0.298) (linear ~0.18)
//   Grey    : 0.305-0.369 - upper midtones                   (linear ~0.38)
//   Pink    : 0.369-0.416 - skin tones / bright midtones     (linear ~0.56)
//   Yellow  : 0.416-0.495 - highlights                       (linear ~1.0)
//   Orange  : 0.495-0.644 - hot highlights (approaching clip)(linear ~3.5)
//   Red     : > 0.644    - clipped                           (linear ~10.0)

// Rec.709 luma weights
const float LW_R = 0.2126f;
const float LW_G = 0.7152f;
const float LW_B = 0.0722f;

__DEVICE__ float3 zone_color(float luma)
{
    // Zone thresholds and colors for Blackmagic Film Gen5 IRE values
    if (luma < 0.038f)
        return make_float3(0.4f, 0.0f, 0.6f);   // Purple - crushed
    else if (luma < 0.092f)
        return make_float3(0.0f, 0.1f, 0.8f);   // Blue - deep shadows
    else if (luma < 0.225f)
        return make_float3(0.0f, 0.6f, 0.6f);   // Teal - shadow detail
    else if (luma < 0.305f)
        return make_float3(0.0f, 0.7f, 0.0f);   // Green - middle grey (~0.298)
    else if (luma < 0.369f)
        return make_float3(0.5f, 0.5f, 0.5f);   // Grey - upper midtones
    else if (luma < 0.416f)
        return make_float3(0.9f, 0.5f, 0.6f);   // Pink - skin tones
    else if (luma < 0.495f)
        return make_float3(0.9f, 0.9f, 0.0f);   // Yellow - highlights
    else if (luma < 0.644f)
        return make_float3(1.0f, 0.5f, 0.0f);   // Orange - hot highlights
    else
        return make_float3(1.0f, 0.0f, 0.0f);   // Red - clipped
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y,
                             float p_R, float p_G, float p_B)
{
    // Input is BMFilm Gen5: compute luma directly in log domain
    float luma = LW_R * p_R + LW_G * p_G + LW_B * p_B;
    return zone_color(luma);
}
