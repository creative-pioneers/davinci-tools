// vlogl_to_rec709.dctl
// ---------------------------------------------------------------------------
// Purpose:   Convert Panasonic V-Log L / V-Gamut to Rec.709 display
// Input:     Panasonic V-Log L encoded, V-Gamut primaries
// Output:    Rec.709 gamma-encoded (BT.1886 display gamma)
// Reference: Panasonic V-Log/V-Gamut specification
// Verified:  DaVinci Resolve 18.6
// ---------------------------------------------------------------------------
//
// Pipeline:
//   1. Invert V-Log L to scene-linear
//   2. Apply V-Gamut -> Rec.709 3x3 matrix
//   3. Apply Rec.709 OETF (BT.1886 display gamma)

// --- Panasonic V-Log L constants ---
const float VLOGL_A       = 0.241514f;
const float VLOGL_B       = 0.00873f;
const float VLOGL_C       = 0.598206f;
const float VLOGL_D       = 5.6f;
const float VLOGL_E       = 0.125f;
const float VLOGL_CUT_IRE = 0.181f;   // 5.6 * 0.01 + 0.125

// --- V-Gamut to Rec.709 matrix ---
// Derived from: XYZ_to_Rec709 * XYZ_from_VGamut
// V-Gamut primaries: R(0.730,0.280) G(0.165,0.840) B(0.100,-0.030) D65 white
// Rec.709 primaries: R(0.640,0.330) G(0.300,0.600) B(0.150,0.060) D65 white
// Source: colour-science Python library
// Neutral preservation: row sums = 1.0 (D65 → D65, no chromatic adaptation)
const float M00 =  1.7234f;  const float M01 = -0.5047f;  const float M02 = -0.2187f;
const float M10 = -0.4396f;  const float M11 =  1.5268f;  const float M12 = -0.0872f;
const float M20 = -0.0392f;  const float M21 = -0.0319f;  const float M22 =  1.0711f;

// --- Rec.709 OETF (BT.1886 inverse EOTF approximation) ---
const float REC709_ALPHA = 1.09929682680944f;
const float REC709_BETA  = 0.018053968510807f;

__DEVICE__ float vlogl_to_linear_f(float x)
{
    if (x >= VLOGL_CUT_IRE)
        return _powf(10.0f, (x - VLOGL_C) / VLOGL_A) - VLOGL_B;
    else
        return (x - VLOGL_E) / VLOGL_D;
}

__DEVICE__ float linear_to_rec709_f(float x)
{
    // Rec.709 OETF
    if (x < 0.0f) return 0.0f;
    if (x < REC709_BETA)
    {
        return 4.5f * x;
    }
    else
    {
        return REC709_ALPHA * _powf(x, 0.45f) - (REC709_ALPHA - 1.0f);
    }
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y,
                             float p_R, float p_G, float p_B)
{
    // Step 1: V-Log L to scene-linear
    float lin_r = vlogl_to_linear_f(p_R);
    float lin_g = vlogl_to_linear_f(p_G);
    float lin_b = vlogl_to_linear_f(p_B);

    // Step 2: V-Gamut to Rec.709 gamut (3x3 matrix)
    float r709 = M00 * lin_r + M01 * lin_g + M02 * lin_b;
    float g709 = M10 * lin_r + M11 * lin_g + M12 * lin_b;
    float b709 = M20 * lin_r + M21 * lin_g + M22 * lin_b;

    // Clamp negatives before gamma (gamut mapping can produce them)
    r709 = _fmaxf(r709, 0.0f);
    g709 = _fmaxf(g709, 0.0f);
    b709 = _fmaxf(b709, 0.0f);

    // Step 3: Linear to Rec.709 gamma
    float3 out;
    out.x = linear_to_rec709_f(r709);
    out.y = linear_to_rec709_f(g709);
    out.z = linear_to_rec709_f(b709);

    return out;
}
