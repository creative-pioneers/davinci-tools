// logc4_to_linear.dctl
// ---------------------------------------------------------------------------
// Purpose:   Convert ARRI LogC4 signal to scene-linear light
// Input:     ARRI LogC4 encoded (ARRI Wide Gamut 4 — ALEXA 35 only)
// Output:    Scene-linear normalised sensor value (same gamut as input)
// Reference: ARRI Science — "ALEXA 35 LogC4 Transfer Characteristic"
// Verified:  DaVinci Resolve 18.6
// Note:      ARRI LogC4 / ALEXA 35 specific. Log2-based, no EI dependence.
//            For ALEXA Mini/Mini LF/Amira (LogC3) see logc3_to_linear.dctl.
//            Inverse: x = (2^(IRE * 9 + 6) - 64) / 16384
//            Black (x=0) encodes to IRE 0.0; middle grey (x≈0.018) to IRE ≈ 0.278
// ---------------------------------------------------------------------------
//
// ARRI LogC4 is a log2-based encoding (no EI dependence):
//   Forward: IRE = (log2(A * x + B) - C) / D
//   Inverse: x   = (2^(IRE * D + C) - B) / A    (clamped to 0)
//
// This DCTL inverts that encoding to recover scene-linear values.

// ARRI LogC4 constants
const float LOGC4_A = 16384.0f;  // 2^14
const float LOGC4_B =    64.0f;  // toe offset
const float LOGC4_C =     6.0f;  // lower anchor (log2(64))
const float LOGC4_D =     9.0f;  // IRE range (15-6)

__DEVICE__ float logc4_to_linear_f(float x)
{
    // Inverse of ARRI LogC4 forward: x = (2^(IRE * D + C) - B) / A
    return _fmaxf((_powf(2.0f, x * LOGC4_D + LOGC4_C) - LOGC4_B) / LOGC4_A, 0.0f);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y,
                             float p_R, float p_G, float p_B)
{
    float3 out;
    out.x = logc4_to_linear_f(p_R);
    out.y = logc4_to_linear_f(p_G);
    out.z = logc4_to_linear_f(p_B);
    return out;
}
