// logc3_to_linear.dctl
// ---------------------------------------------------------------------------
// Purpose:   Convert ARRI LogC3 signal to scene-linear light (EI 800)
// Input:     ARRI LogC3 encoded (ARRI Wide Gamut 3)
// Output:    Scene-linear (same gamut as input)
// Reference: ARRI LogC Curve Usage in VFX (2017), LogC White Paper EI 800 table
//            https://www.arri.com/resource/blob/31918/...
// Verified:  DaVinci Resolve 18.6
// Note:      EI 800 fixed. ARRI Wide Gamut 3. For ALEXA 35 (LogC4) see logc4_to_linear.dctl.
//            For other formats see clog3_to_linear.dctl, slog3_to_linear.dctl.
// ---------------------------------------------------------------------------
//
// ARRI LogC3 is a piecewise function (EI 800):
//   For signal values at/above the linear threshold:
//     IRE = C * log10(A * x + B) + D
//   For signal values below the linear threshold:
//     IRE = E * x + F
//
// This DCTL inverts that encoding to recover scene-linear values.

// ARRI LogC3 constants — EI 800 (from ARRI LogC White Paper 2017)
const float LOGC3_A   = 5.555556f;
const float LOGC3_B   = 0.052272f;
const float LOGC3_C   = 0.247190f;
const float LOGC3_D   = 0.385537f;
const float LOGC3_E   = 5.367655f;
const float LOGC3_F   = 0.092809f;
const float LOGC3_CUT = 0.010591f;  // scene-linear threshold

__DEVICE__ float logc3_to_linear_f(float x)
{
    // Inverse of ARRI LogC3 OETF
    // Input x is the LogC3 IRE value (0-1 normalized)
    // IRE threshold where log segment begins: C*log10(A*CUT+B)+D
    const float CUT_IRE = 0.247190f * _log10f(5.555556f * 0.010591f + 0.052272f) + 0.385537f;
    if (x >= CUT_IRE)
    {
        // Log segment: linear = (10^((x - D) / C) - B) / A
        return (_powf(10.0f, (x - LOGC3_D) / LOGC3_C) - LOGC3_B) / LOGC3_A;
    }
    else
    {
        // Linear segment: linear = (x - F) / E
        return (x - LOGC3_F) / LOGC3_E;
    }
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y,
                             float p_R, float p_G, float p_B)
{
    float3 out;
    out.x = logc3_to_linear_f(p_R);
    out.y = logc3_to_linear_f(p_G);
    out.z = logc3_to_linear_f(p_B);
    return out;
}
