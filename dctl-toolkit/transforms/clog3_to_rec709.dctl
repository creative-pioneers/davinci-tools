// clog3_to_rec709.dctl
// ---------------------------------------------------------------------------
// Purpose:   Convert Canon C-Log 3 / Cinema Gamut to Rec.709 display
// Input:     Canon C-Log 3 encoded, Canon Cinema Gamut primaries
// Output:    Rec.709 gamma-encoded (BT.1886 ~ 2.4 power)
// Reference: Canon Log 3 Transfer Characteristics white paper
//            Canon Cinema Gamut primaries from Canon EOS C-series docs
// Verified:  DaVinci Resolve 18.6
// Note:     Canon C-Log 3 specific — one of several format transforms in this toolkit.
//           For other cameras see slog3_to_linear.dctl, logc3_to_linear.dctl, etc.
// ---------------------------------------------------------------------------
//
// Pipeline:
//   1. Invert C-Log 3 to scene-linear
//   2. Apply Cinema Gamut -> Rec.709 3x3 matrix
//   3. Apply Rec.709 OETF (BT.1886 display gamma)

// --- Canon C-Log 3 constants ---
const float CLOG3_A = 0.42889912f;
const float CLOG3_B = 583.196016f;
const float CLOG3_C = 0.07623209f;
const float CLOG3_D = 8.7537079f;
const float CLOG3_E = 0.09246575f;
const float CLOG3_LINEAR_CUT_IRE_POS = 0.097465473f;
const float CLOG3_LINEAR_CUT_IRE_NEG = 0.08746603f;

// --- Cinema Gamut to Rec.709 matrix ---
// Derived from Canon Cinema Gamut primaries and D65 white point
// to Rec.709 / sRGB primaries (also D65)
// Source: Canon EOS C-series camera documentation, "Cinema Gamut" primaries
//   Cinema Gamut:  R(0.7400, 0.2700), G(0.1700, 1.1400), B(0.0800, -0.1000)
//   Rec.709:       R(0.6400, 0.3300), G(0.3000, 0.6000), B(0.1500, 0.0600)
const float M00 =  1.08190037f; const float M01 = -0.18030718f; const float M02 =  0.09840681f;
const float M10 = -0.00800807f; const float M11 =  1.12279255f; const float M12 = -0.11478448f;
const float M20 = -0.04467524f; const float M21 = -0.27216747f; const float M22 =  1.31684271f;

// --- Rec.709 OETF (BT.1886 inverse EOTF approximation) ---
// Using simple 1/2.4 power law with linear toe
const float REC709_ALPHA = 1.09929682680944f;
const float REC709_BETA  = 0.018053968510807f;

__DEVICE__ float clog3_to_linear_f(float x)
{
    if (x >= CLOG3_LINEAR_CUT_IRE_POS)
    {
        return (_powf(10.0f, (x - CLOG3_C) / CLOG3_A) - 1.0f) / CLOG3_B;
    }
    else if (x <= CLOG3_LINEAR_CUT_IRE_NEG)
    {
        return -((_powf(10.0f, (CLOG3_C - x) / CLOG3_A) - 1.0f) / CLOG3_B);
    }
    else
    {
        return (x - CLOG3_E) / CLOG3_D;
    }
}

__DEVICE__ float linear_to_rec709_f(float x)
{
    // Rec.709 OETF
    if (x < 0.0f) return 0.0f;
    if (x < REC709_BETA)
    {
        return 4.5f * x;
    }
    else
    {
        return REC709_ALPHA * _powf(x, 0.45f) - (REC709_ALPHA - 1.0f);
    }
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y,
                             float p_R, float p_G, float p_B)
{
    // Step 1: C-Log 3 to scene-linear
    float lin_r = clog3_to_linear_f(p_R);
    float lin_g = clog3_to_linear_f(p_G);
    float lin_b = clog3_to_linear_f(p_B);

    // Step 2: Cinema Gamut to Rec.709 gamut (3x3 matrix)
    float r709 = M00 * lin_r + M01 * lin_g + M02 * lin_b;
    float g709 = M10 * lin_r + M11 * lin_g + M12 * lin_b;
    float b709 = M20 * lin_r + M21 * lin_g + M22 * lin_b;

    // Clamp negatives before gamma (gamut mapping can produce them)
    r709 = _fmaxf(r709, 0.0f);
    g709 = _fmaxf(g709, 0.0f);
    b709 = _fmaxf(b709, 0.0f);

    // Step 3: Linear to Rec.709 gamma
    float3 out;
    out.x = linear_to_rec709_f(r709);
    out.y = linear_to_rec709_f(g709);
    out.z = linear_to_rec709_f(b709);

    return out;
}
